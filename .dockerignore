# Секреты — не должны попадать в слои Docker-образа (образ может уйти в registry).
# docker-compose всё равно передаёт переменные в контейнер через env_file: .env — это
# происходит при старте контейнера с хоста, а не через COPY при сборке образа, так что
# .dockerignore на это не влияет.
.env
.env.*
!.env.example

# Версионирование / IDE — не нужны внутри образа
.git
.gitignore
.idea
.vscode

# Виртуальное окружение — образ ставит зависимости сам через requirements.txt
.venv
venv

# Кэши и артефакты
__pycache__
*.pyc
*.pyo
*.log

# Уже пересобираются в образе — не нужно копировать чужие/старые
alembic/versions/__pycache__

# Прочее
README.md
docs
