# App
# local | test | ci — допустимы дефолт-заглушки секретов.
# dev | staging | production — backend НЕ стартует с дефолтным JWT_SECRET_KEY.
ENVIRONMENT=local
DEBUG=true

# CORS — источники фронтенда, которым браузер разрешит вызывать API.
# "*" (по умолчанию) — любой источник; либо список через запятую:
# CORS_ALLOW_ORIGINS=https://app.dev.example.ru,https://admin.dev.example.ru
CORS_ALLOW_ORIGINS=*

# Database.
# ВНИМАНИЕ: под docker-compose эта переменная переопределяется значением из compose-файла
# (postgresql+asyncpg://pdd:pdd@db:5432/pdd). Значение ниже используется только при запуске
# БЕЗ docker-compose (локальный uvicorn + локальный Postgres) — приведите его к своей БД.
DATABASE_URL=postgresql+asyncpg://pdd:pdd@localhost:5432/pdd

# JWT
# ОБЯЗАТЕЛЬНО заменить перед выкладкой куда-либо, кроме локалки:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_IN_PROD
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200

# OAuth
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://app.example.com/oauth/callback
# Dev-only: вход без зарегистрированных приложений Yandex/VK (фейковый профиль по code).
# Работает только когда у провайдера пусты CLIENT_ID/SECRET. НЕ включать в production.
OAUTH_ALLOW_MOCK=false

# Gameplay
DEFAULT_LIVES_MAX=10
# ТЗ v1.5 §4.7: +1 жизнь через N часов с момента, когда жизни опустились ниже максимума.
LIVES_REGEN_HOURS=24
LIVES_RESET_HOUR_UTC=0  # не используется в модели §4.7, оставлено для совместимости

# Exam rules
EXAM_BASE_QUESTIONS=20
EXAM_EXTRA_QUESTIONS_PER_ERROR=5
EXAM_MAX_ERRORS_ALLOWED=2
EXAM_MAX_EXTRA_QUESTIONS=10

# Billing
TRIAL_PRICE_RUB=1
TRIAL_PERIOD_DAYS=3
SUBSCRIPTION_PRICE_RUB=299
SUBSCRIPTION_PERIOD_DAYS=30

ACQUIRER_PROVIDER=yookassa
ACQUIRER_SHOP_ID=
ACQUIRER_SECRET_KEY=
ACQUIRER_WEBHOOK_SECRET=

# Пока ACQUIRER_SHOP_ID/SECRET пусты — работает встроенная заглушка ЮKassa:
# checkout/init отдаёт confirmation_url на страницу PUBLIC_API_BASE_URL/api/v1/billing/mock-pay/<id>,
# а та по кнопке «Оплатить» активирует триал и возвращает браузер на BILLING_RETURN_URL.
PUBLIC_API_BASE_URL=http://localhost:8000
BILLING_RETURN_URL=http://localhost:5173/profile

BILLING_WORKER_INTERVAL_MINUTES=60

# Email + пароль (второй способ входа)
# SMTP: если SMTP_HOST пуст — письма НЕ отправляются, а печатаются в лог backend'а
# (та же логика заглушки, что OAUTH_ALLOW_MOCK / mock-эквайринг). Перед продакшеном —
# реальный SMTP-провайдер с настроенными SPF/DKIM, иначе письма уйдут в спам (см. README).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PDD Test Platform <no-reply@localhost>
SMTP_STARTTLS=true
# Ссылка сброса пароля в письме: {FRONTEND_PASSWORD_RESET_URL}?token=<...>
FRONTEND_PASSWORD_RESET_URL=http://localhost:5173/reset-password
PASSWORD_RESET_TOKEN_TTL_MINUTES=45
# Rate limit (in-memory, на процесс — для MVP; на проде/несколько воркеров → Redis)
LOGIN_RATE_MAX_ATTEMPTS=5
LOGIN_RATE_WINDOW_MINUTES=15
PASSWORD_FORGOT_RATE_MAX_PER_EMAIL=3
PASSWORD_FORGOT_RATE_MAX_PER_IP=10
PASSWORD_FORGOT_RATE_WINDOW_MINUTES=60
